# Printful API — https://www.printful.com/dashboard/store
# Never commit real secrets. Copy to .env.local for local development.
# On Hostinger, set these in the Node.js application's environment panel, then rebuild.

PRINTFUL_API_KEY=
# Live Hostinger currently uses this name — the client accepts either.
PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=18749826

# Stripe Checkout (Dashboard → Developers → API keys)
# Secret is server-only. Publishable is safe to expose; hosted Checkout does not require it at runtime.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional. When set, /api/webhooks/stripe verifies events and creates a Printful order after paid Checkout.
STRIPE_WEBHOOK_SECRET=

# Public origin used for Stripe success/cancel URLs. Production: https://hustlerdior.com
SITE_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL=https://hustlerdior.com

# Optional kill switch. Omit or set true. Set false to refuse Checkout even if keys exist.
# CHECKOUT_ENABLED=true

# Optional comma-separated ISO country codes for Stripe shipping_address_collection (default US).
# CHECKOUT_ALLOWED_COUNTRIES=US

# Optional Stripe shipping line in cents. Omit to charge Printful retail only (no shipping line).
# STRIPE_SHIPPING_CENTS=800
