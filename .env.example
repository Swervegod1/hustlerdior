# Server-only. Never prefix these secrets with NEXT_PUBLIC_. Never commit .env.local.
# Live Hostinger may use PRINTFUL_API_TOKEN (preferred) or PRINTFUL_API_KEY. Both are accepted.
PRINTFUL_API_TOKEN=
PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=
PRINTFUL_SELLING_REGION=usa
SITE_URL=http://localhost:3000
# Local, backup, and non-canonical hosts stay out of search.
# https://hustlerdior.com is indexable even if these pre-launch values are still set.
# SITE_ROLE=backup always noindexes. SEARCH_INDEXING is not required for the public host.
SITE_ROLE=preview
SEARCH_INDEXING=false
# Optional public ownership-verification token from Google Search Console (not an API key).
GOOGLE_SITE_VERIFICATION=

# Issued by Printful after registering v2 webhooks; secret_key is HEX, not UTF-8.
PRINTFUL_WEBHOOK_PUBLIC_KEY=
PRINTFUL_WEBHOOK_SECRET_HEX=

# Read-only visual preview using the sanitized catalog snapshot. Ignored when a Printful token is set.
# Checkout and live inventory always require a working API token.
CATALOG_SNAPSHOT_PREVIEW=false

# Hostinger's token belongs in your deployment tooling, not the storefront runtime.
# Do not invent secret values. Leave payment keys empty until they are issued in Stripe.

# Optional durable commerce/usage storage. When unset, quotes live in process memory and
# Stripe Checkout Session metadata is used to recover paid orders for Printful drafts.
DATABASE_URL=
# Optional. Falls back to STRIPE_SECRET_KEY when that key is at least 32 characters.
APP_SESSION_SECRET=
# Separate server-only credential for the Vercel scheduled payment worker.
CRON_SECRET=

# Stripe hosted Checkout. Enabled automatically when STRIPE_SECRET_KEY is a valid sk_/rk_ key.
# Set CHECKOUT_ENABLED=false to force the disabled storefront copy.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY is not required (hosted Checkout, not Stripe.js).
CHECKOUT_ENABLED=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# automatic uses Stripe Tax when registrations/settings are active; otherwise tax is left off.
STRIPE_TAX_MODE=
# Modeled contribution after Printful costs, assumed fees and a returns reserve; before ads/overhead.
MIN_CONTRIBUTION_RATE=0.35

# Server-side image editing. Obtain credentials through the secure API key setup flow.
TRYON_ENABLED=false
OPENAI_API_KEY=
TRYON_MODEL=gpt-image-2.5-sunburst
# Global generation-attempt ceiling per UTC day. Zero keeps generation disabled.
TRYON_DAILY_LIMIT=0

# Approved S&S account: server-only, read-only supplier quote import.
SS_ACTIVEWEAR_ACCOUNT_NUMBER=
SS_ACTIVEWEAR_API_KEY=

# Owner-only alerts after the shopper explicitly requests human help.
# Requires migrated database, signed sessions and an approved Twilio sender.
SUPPORT_SMS_ENABLED=false
SUPPORT_SMS_DAILY_LIMIT=10
SUPPORT_SMS_TO=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
