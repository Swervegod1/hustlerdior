# Server-only. Never prefix these secrets with NEXT_PUBLIC_. Never commit .env.local.
PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=18747907
PRINTFUL_SELLING_REGION=usa
SITE_URL=http://localhost:3000
# Keep drafts and recovery instances out of search. Enable only on the verified primary domain.
SITE_ROLE=preview
SEARCH_INDEXING=false
# Optional public ownership-verification token from Google Search Console (not an API key).
GOOGLE_SITE_VERIFICATION=

# Issued by Printful after registering v2 webhooks; secret_key is HEX, not UTF-8.
PRINTFUL_WEBHOOK_PUBLIC_KEY=
PRINTFUL_WEBHOOK_SECRET_HEX=

# Read-only visual preview using the sanitized catalog snapshot. Default: false.
# Checkout and live inventory always require a working API key.
CATALOG_SNAPSHOT_PREVIEW=false

# Hostinger's token belongs in your deployment tooling, not the storefront runtime.
# Payments and AI previews remain disabled until their runtime services are configured.

# Durable commerce/usage storage and signed browser sessions.
DATABASE_URL=
APP_SESSION_SECRET=
# Separate server-only credential for the Vercel scheduled payment worker.
CRON_SECRET=

# Stripe hosted Checkout. Keep disabled until launch configuration and policies are reviewed.
CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# automatic requires active Stripe Tax settings/registrations; test_none accepts test keys only.
STRIPE_TAX_MODE=automatic
# Modeled contribution after Printful costs, assumed fees and a returns reserve; before ads/overhead.
MIN_CONTRIBUTION_RATE=0.35

# Server-side image editing. Obtain credentials through the secure API key setup flow.
TRYON_ENABLED=false
OPENAI_API_KEY=
TRYON_MODEL=gpt-image-2.5-sunburst
# Global generation-attempt ceiling per UTC day. Zero keeps generation disabled.
TRYON_DAILY_LIMIT=0

# Approved S&S account: server-only, read-only supplier quote import.
SS_ACTIVEWEAR_ACCOUNT_NUMBER=
SS_ACTIVEWEAR_API_KEY=

# Owner-only alerts after the shopper explicitly requests human help.
# Requires migrated database, signed sessions and an approved Twilio sender.
SUPPORT_SMS_ENABLED=false
SUPPORT_SMS_DAILY_LIMIT=10
SUPPORT_SMS_TO=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
