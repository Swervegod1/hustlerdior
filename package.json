{
  "name": "hustlerdior-storefront",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env.local .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "catalog:export": "node --import tsx --env-file=.env.local scripts/export-catalog.mjs",
    "webhooks:register": "node --env-file=.env.local scripts/register-webhooks.mjs",
    "format": "prettier --write .",
    "margin:audit": "node --import tsx --env-file=.env.local scripts/margin-audit.mjs",
    "backup": "node scripts/backup.mjs",
    "recovery": "node recovery/server.mjs",
    "margin:report": "node --import tsx scripts/render-margin-report.mjs",
    "inventory:dropship": "node --import tsx scripts/stage-dropship-candidates.mjs",
    "inventory:review": "node --import tsx scripts/render-dropship-review.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "orders:work": "node --conditions=react-server --env-file-if-exists=.env.local .next/standalone/payment-worker.mjs",
    "test:server": "node --conditions=react-server --import tsx --test tests/server/*.test.ts",
    "orders:work:dev": "node --conditions=react-server --import tsx --env-file-if-exists=.env.local scripts/payment-worker.ts",
    "inventory:shopify": "node --import tsx scripts/stage-shopify-import.mjs",
    "inventory:printful": "node --import tsx --env-file=.env.local scripts/import-printful-inventory.mjs",
    "checkout:check": "node --env-file-if-exists=.env.local scripts/check-checkout.mjs"
  },
  "dependencies": {
    "@fontsource/anton": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@react-three/postprocessing": "3.1.1",
    "framer-motion": "13.2.0",
    "lenis": "1.3.26",
    "next": "16.3.5",
    "openai": "7.15.0",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "stripe": "22.6.2",
    "three": "0.186.0",
    "zod": "4.6.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "26.5.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "autoprefixer": "10.6.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
